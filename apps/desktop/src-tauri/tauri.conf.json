{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos",
  "mainBinaryName": "todolist",
  "version": "../package.json",
  "identifier": "app.todolist.local",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kairos",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "todolist",
    "category": "Productivity",
    "shortDescription": "Local-first todo list and calendar",
    "longDescription": "A local-first todo list and calendar desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "43297d5b-568f-5501-a39c-7a2d2d79db89"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/VitaVance/Kairos/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCNThGRDk5N0QxNEI4NTgKUldSWXVCUjltZjFZUzd2U2JhZ0E0RUlSSzNyYXo2ZUtPRDU1bFg0cm9jSTI4NVgzR0p5Q1p0R0UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
