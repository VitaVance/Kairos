# This app is local-first: there is no server, no API key, no cloud endpoint.
# Everything below is optional and only affects development ergonomics.

# Vite dev server port (default 5173, must match src-tauri/tauri.conf.json devUrl)
# VITE_PORT=5173

# Rust / Tauri logging (only used by the desktop shell)
# RUST_LOG=info
